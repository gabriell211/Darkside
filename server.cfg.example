# DarkSide - exemplo mínimo de configuração RedM

sv_hostname "DarkSide DEV"
sets sv_projectName "DarkSide"
sets sv_projectDesc "DarkSide supernatural multiplayer"

set gamename rdr3

# OneSync
set onesync on

# Banco
set mysql_connection_string "mysql://USER:PASSWORD@127.0.0.1/darkside?charset=utf8mb4"

# Voz (pma-voice / Mumble interno do Cfx)
# Native audio permite espacialização/reverb/submix no RedM.
setr voice_useNativeAudio true
setr voice_useSendingRangeOnly true
setr voice_enableUi 1
setr voice_enableProximityCycle 1
setr voice_defaultVoiceMode 2
setr voice_enableSubmix 1

# DarkSide ainda não usa telefone/rádio. Mantemos os módulos desligados por enquanto.
setr voice_enableRadios 0
setr voice_enableCalls 0
setr voice_enableRadioAnim 0

# Dependências standalone
ensure oxmysql
ensure ox_lib

# Voz
ensure pma-voice

# Base RSG mínima
ensure rsg-core
ensure rsg-menubase
ensure rsg-inventory
ensure rsg-appearance

# DarkSide
ensure ds_core
ensure ds_clans
ensure ds_powers
ensure ds_voice
ensure ds_ai
ensure ds_killers
ensure ds_horror

# Futuras camadas do jogo, conforme forem implementadas:
# ensure ds_inventory
# ensure ds_progression
# ensure ds_zones
# ensure ds_entities
# ensure ds_director
# ensure ds_events
# ensure ds_hud
# ensure ds_audio
# ensure ds_admin

# Permissão para comandos de desenvolvimento DarkSide.
# Associe seu identificador a um grupo/admin conforme sua base e mantenha esta ACE.
add_ace group.admin darkside.admin allow

# Adicione sua key da Cfx.re abaixo
sv_licenseKey "CHANGE_ME"
